# Database (Next.js Route Handlers that use Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/school_management?schema=public"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3002/api"

# Must match Nest `JWT_ACCESS_SECRET` (used to validate access tokens when minting the HttpOnly UI session cookie).
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long

# Optional: separate secret for the UI session JWT. If omitted, `JWT_ACCESS_SECRET` is used for signing the UI cookie as well.
# SMS_UI_SESSION_SECRET=
